# 应用配置
APP_NAME=AideCMS
APP_VERSION=1.0.0
APP_URL=http://localhost:8888
APP_TIMEZONE=UTC
APP_ENV=development
APP_DEBUG=true
APP_KEY=

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8888


# 数据库类型: mysql, sqlite 或 postgres
DB_TYPE=sqlite

# MySQL 配置 (当DB_TYPE=mysql时生效)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aidecms
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# PostgreSQL 配置 (当DB_TYPE=postgres时生效)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=aidecms
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# SQLite 配置 (当DB_TYPE=sqlite时生效)
SQLITE_DATABASE=database/data.db
SQLITE_USERNAME=
SQLITE_PASSWORD=

# Redis配置
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=
REDIS_TIMEOUT=5

# ClickHouse 配置
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DEBUG=false
CLICKHOUSE_MAX_OPEN_CONNS=10
CLICKHOUSE_MAX_IDLE_CONNS=5
CLICKHOUSE_MAX_LIFETIME=3600

# 日志配置
LOG_CHANNEL=stack
LOG_LEVEL=debug

# 邮件配置
# 方式1: 单服务器配置（兼容旧版本）
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# 方式2: 多服务器配置（推荐用于群发和防封禁）
# MAIL_SERVERS=JSON格式的服务器配置数组
# MAIL_DRIVER=smtp
# MAIL_FAILOVER_ENABLED=true
# MAIL_LOAD_BALANCE_MODE=round_robin  # round_robin, priority, weighted
# MAIL_HEALTH_CHECK_INTERVAL=60  # 健康检查间隔（秒）
# 
# MAIL_SERVERS示例（请使用一行）:
# [
#   {
#     "id": "gmail_primary",
#     "host": "smtp.gmail.com",
#     "port": 587,
#     "username": "user1@gmail.com",
#     "password": "password1",
#     "encryption": "tls",
#     "from_name": "Your Company",
#     "from_email": "user1@gmail.com",
#     "enabled": true,
#     "priority": 1,
#     "weight": 10
#   },
#   {
#     "id": "outlook_secondary",
#     "host": "smtp-mail.outlook.com",
#     "port": 587,
#     "username": "user2@outlook.com",
#     "password": "password2",
#     "encryption": "tls",
#     "from_name": "Your Company",
#     "from_email": "user2@outlook.com",
#     "enabled": true,
#     "priority": 2,
#     "weight": 8
#   },
#   {
#     "id": "custom_smtp",
#     "host": "smtp.example.com",
#     "port": 587,
#     "username": "user3@example.com",
#     "password": "password3",
#     "encryption": "tls",
#     "from_name": "Your Company",
#     "from_email": "user3@example.com",
#     "enabled": true,
#     "priority": 3,
#     "weight": 5
#   }
# ]

# PayPal 支付配置
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Stripe 支付配置
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# MoonPay 支付配置
MOONPAY_ENABLED=false
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
MOONPAY_SANDBOX=true

# Coinbase 支付配置
COINBASE_ENABLED=false
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_WEBHOOK_KEY=
COINBASE_ACCOUNT_ID=
COINBASE_SANDBOX=true

# KuCoin 交易配置
KUCOIN_ENABLED=false
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
KUCOIN_SANDBOX=true

# AI 配置
AI_DEFAULT_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-test-api-key-for-development
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# 通用配置
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1

# 功能开关
AI_CHAT_ENABLED=true
AI_COMPLETION_ENABLED=true
AI_EMBEDDING_ENABLED=true
AI_STREAMING_ENABLED=true

# 安全设置
AI_CONTENT_FILTER_ENABLED=true
AI_AUDIT_LOG_ENABLED=true